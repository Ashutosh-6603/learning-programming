{
  "name": "taskflow-nestjs",
  "version": "1.0.0",
  "description": "TaskFlow API: NestJS 12 + TypeORM + PostgreSQL + Redis",
  "scripts": {
    "dev": "nest start --watch",
    "dev:worker": "nest start --watch --entryFile worker",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run src",
    "test:e2e": "vitest run test",
    "test:coverage": "vitest run --coverage",
    "db:generate": "nest build && typeorm migration:generate -d dist/database/data-source.js -p",
    "db:migrate": "nest build && node dist/migrate.js",
    "db:drift": "nest build && typeorm migration:generate -d dist/database/data-source.js --check src/database/migrations/Drift",
    "test:contract": "schemathesis run contract/openapi.yaml --url http://localhost:8003",
    "db:seed": "nest build && node dist/seed.js"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "private": true,
  "dependencies": {
    "@aws-sdk/client-s3": "3.1167.0",
    "@aws-sdk/s3-request-presigner": "3.1167.0",
    "@nestjs/bullmq": "12.0.1",
    "@nestjs/common": "12.4.2",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.4.2",
    "@nestjs/jwt": "12.0.4",
    "@nestjs/passport": "12.0.1",
    "@nestjs/platform-express": "12.4.2",
    "@nestjs/platform-ws": "12.4.2",
    "@nestjs/swagger": "12.1.1",
    "@nestjs/typeorm": "12.0.3",
    "@nestjs/websockets": "12.4.2",
    "argon2": "0.45.2",
    "bullmq": "6.7.5",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "ioredis": "5.11.1",
    "nestjs-pino": "5.3.1",
    "nodemailer": "10.5.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.2",
    "uuid": "14.0.3",
    "ws": "8.22.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.12",
    "@nestjs/schematics": "12.0.13",
    "@nestjs/testing": "12.4.2",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/passport-jwt": "4.0.1",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@types/ws": "8.18.2",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.10.0",
    "supertest": "7.3.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "argon2": false,
    "msgpackr-extract": false,
    "@scarf/scarf": false
  }
}
