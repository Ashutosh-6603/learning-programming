# Normalise line endings to LF so shell scripts (mvnw, entrypoints) run in
# Docker/Linux even if the repo is ever checked out on Windows.
* text=auto eol=lf

*.cmd text eol=crlf
*.bat text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.jar binary
*.woff binary
*.woff2 binary
